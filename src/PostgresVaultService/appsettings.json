{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "PostgresVaultService"
    }
  },
  "Vault": {
    "Address": "http://vault:8200",
    "RoleId": "",
    "SecretId": "",
    "DatabaseMountPoint": "database",
    "StaticRoleName": "app-tech",
    "PollIntervalSeconds": 15
  },
  "Postgres": {
    "Host": "postgres",
    "Port": 5432,
    "Database": "appdb",
    "Username": "app_tech",
    "InsertIntervalSeconds": 5,
    "CommandTimeoutSeconds": 30
  },
  "Resilience": {
    "VaultMaxRetryAttempts": 3,
    "VaultRetryDelaySeconds": 2,
    "VaultTimeoutSeconds": 30,
    "PostgresMaxRetryAttempts": 3,
    "PostgresRetryDelaySeconds": 2,
    "PostgresTimeoutSeconds": 30
  }
}
